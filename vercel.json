{
  "rewrites": [
    {
      "source": "/2024",
      "destination": "/"
    },
    {
      "source": "/2024/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(avif|webp|svg|png|jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, stale-while-revalidate=120"
        }
      ]
    }
  ]
}
