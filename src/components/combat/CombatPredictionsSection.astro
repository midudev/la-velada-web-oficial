---
import PredictionFight from '@/components/PredictionFight.astro'
import SectionDivider from '@/components/SectionDivider.astro'
import type { PredictionBattle } from '@/consts/predictions'

interface Props {
  prediction: PredictionBattle | null
}

const { prediction } = Astro.props
---

{
  prediction && (
    <section
      class="combat-section px-4 pt-10 pb-20 sm:px-6 sm:pb-24"
      aria-labelledby="battle-predictions-title"
    >
      <div class="mx-auto w-full max-w-7xl">
        <div class="mb-10 flex flex-col items-center gap-2 text-center">
          <SectionDivider size="sm" class="w-full" />
          <h2
            id="battle-predictions-title"
            class="font-cinzel text-xs font-bold tracking-[0.38em] text-theme-gold/85 sm:text-sm"
          >
            PRONÓSTICOS
          </h2>
        </div>

        <ol class="grid gap-5 md:gap-6" role="list">
          <PredictionFight prediction={prediction} />
        </ol>
      </div>
    </section>
  )
}

<style>
  .combat-section {
    position: relative;
    z-index: 2;
    color: var(--color-theme-cream);
    background: transparent;
  }
</style>
