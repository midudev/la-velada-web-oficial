---
// Barra conmemorativa: aparece arriba del todo, dentro del header fijo.
// Es un guiño, no contenido del evento: sin enlaces y `aria-hidden` en el
// emoji, pero con texto real para que se lea en lectores de pantalla.
---

<div
  class="via-theme-blood/80 relative overflow-hidden border-b border-theme-gold/30 bg-gradient-to-r from-theme-maroon to-theme-maroon"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,79,159,0.25),transparent_65%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="relative mx-auto flex max-w-7xl items-center justify-center gap-2.5 px-4 py-1.5 sm:gap-3 sm:py-2"
  >
    <img
      src="/img/midu.jpg"
      alt="Midu"
      width="36"
      height="36"
      loading="eager"
      decoding="async"
      class="size-7 shrink-0 rounded-full border border-theme-gold/70 object-cover shadow-[0_0_10px_rgba(199,168,107,0.45)] sm:size-9"
    />
    <p
      class="font-cinzel text-[11px] font-black tracking-[0.18em] text-theme-cream uppercase sm:text-sm sm:tracking-[0.24em]"
    >
      Te queremos Midu
    </p>
    <span class="animate-pulse text-xs sm:text-sm" aria-hidden="true" data-midu-heart>❤️</span>
  </div>
</div>
