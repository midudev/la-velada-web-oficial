---
import ArrowRightIcon from '@/assets/svg/arrow-right.svg'
import {
  getBattleResult,
  getDecisionLabel,
  getWinnerWord,
} from '@/consts/battle-results'
import { BOXERS_BY_ID, getBoxerSelectImages } from '@/consts/boxers'
import { formatPredictionPercent, formatPredictionVotes } from '@/lib/format-votes'

interface BoxerRef {
  id: string
  name: string
}

interface PredictionSide {
  fighter_id: string
  votes: number
  percentage: number
}

interface Props {
  battleId: string
  // Orden de combate: A = boxerIds[0] (navy), B = boxerIds[1] (oro), para que
  // los colores coincidan con la página de /pronosticos.
  boxerA: BoxerRef
  boxerB: BoxerRef
  // Totales fijados en build; sin polling ni llamadas a la API en cliente.
  sides?: readonly PredictionSide[]
  totalVotes?: number
  href?: string
  class?: string
}

const {
  battleId,
  boxerA,
  boxerB,
  sides = [],
  totalVotes = 0,
  href = `/pronosticos#pronostico-${battleId}`,
  class: className,
} = Astro.props

const sideById = new Map(sides.map((side) => [side.fighter_id, side]))
const sideA = sideById.get(boxerA.id)
const sideB = sideById.get(boxerB.id)
const percentageA = sideA?.percentage ?? 0
const percentageB = sideB?.percentage ?? 0
const hasVotes = totalVotes > 0
const isTie = hasVotes && percentageA === percentageB
const leaderId =
  hasVotes && !isTie ? (percentageA > percentageB ? boxerA.id : boxerB.id) : ''

const result = getBattleResult(battleId)
const winnerBoxer = result
  ? result.winnerId === boxerA.id
    ? BOXERS_BY_ID[boxerA.id]
    : result.winnerId === boxerB.id
      ? BOXERS_BY_ID[boxerB.id]
      : null
  : null
const winnerWord = winnerBoxer ? getWinnerWord(winnerBoxer.gender) : null
const decisionLabel = result ? getDecisionLabel(result) : null

// Recortes redondos de cada boxeador (mismos que usa la tarjeta VS).
const imagesA = getBoxerSelectImages(BOXERS_BY_ID[boxerA.id])
const imagesB = getBoxerSelectImages(BOXERS_BY_ID[boxerB.id])

const ariaLabel = [
  `Pronóstico de la comunidad: ${boxerA.name} contra ${boxerB.name}`,
  winnerBoxer && winnerWord && decisionLabel
    ? `${winnerWord}: ${winnerBoxer.name}. ${decisionLabel}`
    : '',
]
  .filter(Boolean)
  .join('. ')
---

<div
  class:list={['live-pred', className]}
  data-live-prediction
  data-battle-id={battleId}
  data-has-votes={String(hasVotes)}
  role="group"
  aria-label={ariaLabel}
>
  <div class="live-pred-top font-cinzel">
    <span class="live-pred-eyebrow">Pronóstico de la comunidad</span>
    <span class="live-pred-total">{formatPredictionVotes(totalVotes)} votos</span>
  </div>

  <div class="live-pred-scores font-cinzel">
    <div
      class:list={[
        'live-pred-score',
        'a',
        { 'is-leader': leaderId === boxerA.id, 'is-winner': result?.winnerId === boxerA.id },
      ]}
    >
      <picture class="live-pred-avatar">
        <source type="image/avif" srcset={imagesA.avif} />
        <source type="image/webp" srcset={imagesA.webp} />
        <img
          src={imagesA.webp}
          alt=""
          role="presentation"
          loading="lazy"
          decoding="async"
          width="52"
          height="52"
        />
      </picture>
      <span class="live-pred-score-text">
        <span class="live-pred-name">{boxerA.name}</span>
        <span class="live-pred-pct">{hasVotes ? formatPredictionPercent(percentageA) : '—'}</span>
      </span>
    </div>
    <div
      class:list={[
        'live-pred-score',
        'b',
        { 'is-leader': leaderId === boxerB.id, 'is-winner': result?.winnerId === boxerB.id },
      ]}
    >
      <picture class="live-pred-avatar">
        <source type="image/avif" srcset={imagesB.avif} />
        <source type="image/webp" srcset={imagesB.webp} />
        <img
          src={imagesB.webp}
          alt=""
          role="presentation"
          loading="lazy"
          decoding="async"
          width="52"
          height="52"
        />
      </picture>
      <span class="live-pred-score-text">
        <span class="live-pred-name">{boxerB.name}</span>
        <span class="live-pred-pct">{hasVotes ? formatPredictionPercent(percentageB) : '—'}</span>
      </span>
    </div>
  </div>

  <div class="live-pred-track" aria-hidden="true">
    <span class="live-pred-fill live-pred-fill-a" style={`width: ${hasVotes ? percentageA : 0}%`}
    ></span>
    <span class="live-pred-fill live-pred-fill-b" style={`width: ${hasVotes ? percentageB : 0}%`}
    ></span>
  </div>

  {
    winnerBoxer && winnerWord && decisionLabel && (
      <p class="live-pred-result font-cinzel">
        <span class="live-pred-result-label">{winnerWord}</span>
        <span class="live-pred-result-name">{winnerBoxer.name}</span>
        <span class="live-pred-result-decision">{decisionLabel}</span>
      </p>
    )
  }

  <a class="live-pred-cta font-cinzel" href={href}>
    <span>Ver pronóstico</span>
    <ArrowRightIcon class="live-pred-cta-arrow" aria-hidden="true" />
  </a>
</div>

<style>
  .live-pred {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: 100%;
    padding: 1rem 1.1rem 1.05rem;
    border-radius: 1.1rem;
    background: linear-gradient(180deg, rgba(15, 18, 36, 0.55) 0%, rgba(7, 10, 21, 0.66) 100%);
    border: 1px solid color-mix(in srgb, var(--color-theme-gold) 24%, transparent);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.4);
  }

  .live-pred-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .live-pred-eyebrow {
    font-size: 0.5rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-theme-gold) 82%, transparent);
  }

  .live-pred-total {
    font-size: 0.5rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-theme-cream) 52%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .live-pred-scores {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .live-pred-score {
    display: flex;
    flex: 1 1 0;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }
  .live-pred-score.b {
    flex-direction: row-reverse;
    text-align: right;
  }

  /* Recorte redondo del boxeador, con anillo dorado de marca. */
  .live-pred-avatar {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 9999px;
    overflow: hidden;
    background: linear-gradient(180deg, #0c1330 0%, #060a1d 100%);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-theme-gold) 32%, transparent);
  }
  .live-pred-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .live-pred-score.is-leader .live-pred-avatar,
  .live-pred-score.is-winner .live-pred-avatar {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-theme-gold) 78%, transparent),
      0 0 16px color-mix(in srgb, var(--color-theme-gold) 28%, transparent);
  }

  .live-pred-score-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .live-pred-name {
    overflow: hidden;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-theme-cream) 78%, transparent);
  }

  .live-pred-pct {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--color-theme-cream);
  }

  /* El favorito de la comunidad y el ganador oficial se realzan en oro. */
  .live-pred-score.is-leader .live-pred-pct,
  .live-pred-score.is-winner .live-pred-pct {
    color: var(--color-theme-gold);
    text-shadow: 0 0 18px color-mix(in srgb, var(--color-theme-gold) 35%, transparent);
  }
  .live-pred-score.is-winner .live-pred-name {
    color: color-mix(in srgb, var(--color-theme-gold) 70%, var(--color-theme-cream));
  }
  .live-pred[data-has-votes='true'] .live-pred-score:not(.is-leader):not(.is-winner) {
    opacity: 0.78;
  }

  .live-pred-result {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.25rem 0.45rem;
    margin: 0;
    text-align: center;
    line-height: 1.2;
  }

  .live-pred-result-label {
    font-size: 0.48rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-theme-gold) 85%, transparent);
  }

  .live-pred-result-name {
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-theme-cream);
  }

  .live-pred-result-decision {
    width: 100%;
    font-size: 0.48rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-theme-cream) 52%, transparent);
  }

  /* Barra tug-of-war: A crece desde la izquierda, B desde la derecha. */
  .live-pred-track {
    position: relative;
    height: 12px;
    border-radius: 999px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.45));
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .live-pred-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
  }
  .live-pred-fill-a {
    left: 0;
    border-radius: 999px 0 0 999px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-theme-navy) 55%, white),
      color-mix(in srgb, var(--color-theme-navy) 32%, white)
    );
  }
  .live-pred-fill-b {
    right: 0;
    border-radius: 0 999px 999px 0;
    background: linear-gradient(
      270deg,
      var(--color-theme-gold),
      color-mix(in srgb, var(--color-theme-gold) 68%, white)
    );
  }

  /* Sin votos todavía: barra apagada y centrada. */
  .live-pred[data-has-votes='false'] .live-pred-track {
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--color-theme-gold) 14%, transparent) 50%,
      transparent
    );
  }

  .live-pred-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    align-self: center;
    margin-top: 0.15rem;
    padding: 0.5rem 1.15rem;
    border-radius: 999px;
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-theme-gold);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-theme-gold) 38%, transparent);
    transition:
      color 250ms ease,
      box-shadow 250ms ease,
      background-color 250ms ease,
      transform 250ms ease;
  }
  .live-pred-cta:hover,
  .live-pred-cta:focus-visible {
    color: var(--color-theme-midnight);
    background: var(--color-theme-gold);
    box-shadow: inset 0 0 0 1px var(--color-theme-gold);
    outline: none;
    transform: translateY(-1px);
  }

  .live-pred-cta-arrow {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
    transition: transform 250ms ease;
  }
  .live-pred-cta:hover .live-pred-cta-arrow,
  .live-pred-cta:focus-visible .live-pred-cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .live-pred-cta,
    .live-pred-cta-arrow {
      transition: none;
    }
    .live-pred-cta:hover,
    .live-pred-cta:focus-visible {
      transform: none;
    }
  }
</style>
