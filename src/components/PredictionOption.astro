---
import CountryFlag from '@/components/CountryFlag.astro'
import { getWinnerWord } from '@/consts/battle-results'
import {
  formatPredictionPercent,
  formatPredictionSupport,
  type PredictionOption,
} from '@/consts/predictions'

interface Props {
  battleId: string
  option: PredictionOption
  leaderBoxerId?: string
  winnerBoxerId?: string
}

const { battleId, option, leaderBoxerId, winnerBoxerId } = Astro.props
const isLeader = Boolean(leaderBoxerId) && leaderBoxerId === option.boxer.id
const isWinner = Boolean(winnerBoxerId) && winnerBoxerId === option.boxer.id
const winnerWord = isWinner ? getWinnerWord(option.boxer.gender) : null
const ariaLabel = [
  `${option.boxer.name}: ${formatPredictionPercent(option.percentage)} (${formatPredictionSupport(option.votes)})`,
  winnerWord ? `${winnerWord} oficial del combate.` : '',
]
  .filter(Boolean)
  .join('. ')
---

<div
  class:list={['tow-side', option.side]}
  data-battle-id={battleId}
  data-boxer-id={option.boxer.id}
  data-boxer-name={option.boxer.name}
  data-prediction-option
  data-selected="false"
  data-muted="false"
  data-leader={String(isLeader)}
  data-winner={String(isWinner)}
  data-side={option.side}
  data-vote-count={option.votes}
  data-vote-percentage={option.percentage}
  role="group"
  aria-label={ariaLabel}
  style={`--vote-share: ${option.percentage.toFixed(2)}%; --vote-color: ${option.color};`}
>
  <picture class="tow-pic">
    <source type="image/avif" srcset={option.heroImages.avif} />
    <source type="image/webp" srcset={option.heroImages.webp} />
    <img
      src={option.heroImages.webp}
      alt={`Recorte de ${option.boxer.name}`}
      loading="lazy"
      decoding="async"
      width="320"
      height="420"
      class="tow-pic-img"
    />
  </picture>

  <span aria-hidden="true" style="opacity: 0" class="tow-spot"></span>
  <span aria-hidden="true" class="tow-veil"></span>
  <span aria-hidden="true" class="tow-frame"></span>

  {
    isWinner && winnerWord && (
      <span class="tow-winner-badge font-cinzel" aria-hidden="true">
        ★ {winnerWord}
      </span>
    )
  }

  <span class="tow-caption">
    <span aria-hidden="true" style="display: none" class="tow-yourvote font-cinzel">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="tow-yourvote-check"
        ><path d="M20 6 9 17l-5-5"></path></svg
      >
      Tu voto
    </span>
    <span class="tow-percent font-cinzel" data-prediction-percent>
      {formatPredictionPercent(option.percentage)}
    </span>
    <span class="tow-name font-cinzel">{option.boxer.name}</span>
    <span class="tow-country font-cinzel">
      <CountryFlag country={option.boxer.country} size={13} decorative class="tow-flag" />
      <span>{option.countryName}</span>
    </span>
    <span class="tow-votes font-cinzel" data-prediction-votes>
      {formatPredictionSupport(option.votes)}
    </span>
  </span>

  <span aria-hidden="true" class="tow-fill"></span>
</div>

<style>
  /* static: el .tow-fill se ancla al .tow-stage (relative), no al lado,
     para que la barra cruce de extremo a extremo las dos fotos. */
  .tow-side {
    position: static;
    display: grid;
    grid-template: 'stack' / 1fr;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 0;
    padding: 0;
    margin: 0;
    background: color-mix(in srgb, var(--color-theme-navy) 70%, black);
    color: var(--color-theme-cream);
    text-align: center;
  }

  .tow-pic {
    grid-area: stack;
    z-index: 1;
    display: block;
    overflow: hidden;
  }
  .tow-pic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: saturate(0.92) brightness(0.9);
  }
  .tow-side.b .tow-pic-img {
    transform: scaleX(-1);
  }

  /* Halo del líder / ganador: glow detrás del boxeador (z-0). */
  .tow-spot {
    grid-area: stack;
    z-index: 0;
    background: radial-gradient(
      72% 64% at 50% 40%,
      color-mix(in srgb, var(--color-theme-cream) 55%, transparent),
      color-mix(in srgb, var(--color-theme-gold) 22%, transparent) 46%,
      transparent 72%
    );
  }
  /* Oculto por style inline (opacity:0, evita el flash en dev). El líder o
     ganador lo revela con !important para ganar al inline. */
  .tow-side[data-leader='true'] .tow-spot,
  .tow-side[data-winner='true'] .tow-spot {
    opacity: 0.55 !important;
  }
  .tow-side[data-winner='true'] .tow-spot {
    opacity: 0.72 !important;
    background: radial-gradient(
      75% 65% at 50% 36%,
      color-mix(in srgb, var(--color-theme-gold) 52%, transparent),
      color-mix(in srgb, var(--color-theme-gold) 18%, transparent) 48%,
      transparent 72%
    );
  }
  .tow-side[data-leader='true'] .tow-pic-img,
  .tow-side[data-winner='true'] .tow-pic-img {
    filter: saturate(1.06) brightness(1.05);
  }

  /* Badge de resultado oficial (estático; no depende de sesión).
     Vive en el mismo stack del lado: no usamos absolute porque .tow-side
     es static a propósito (la barra .tow-fill ancla al .tow-stage). */
  .tow-winner-badge {
    grid-area: stack;
    z-index: 7;
    align-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    margin: 0.55rem;
    padding: 0.28rem 0.62rem;
    height: fit-content;
    width: fit-content;
    border-radius: 999px;
    font-size: 0.48rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-theme-midnight);
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-theme-gold) 92%, white) 0%,
      var(--color-theme-gold) 55%,
      color-mix(in srgb, var(--color-theme-gold) 72%, #6b4f1e) 100%
    );
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 35%, transparent),
      0 4px 14px color-mix(in srgb, var(--color-theme-gold) 45%, transparent);
    pointer-events: none;
  }
  .tow-side.a .tow-winner-badge {
    justify-self: end;
  }
  .tow-side.b .tow-winner-badge {
    justify-self: start;
  }

  .tow-veil {
    grid-area: stack;
    z-index: 2;
    background: linear-gradient(
      180deg,
      transparent 50%,
      rgba(5, 8, 15, 0.28) 74%,
      rgba(5, 8, 15, 0.8) 100%
    );
  }

  .tow-frame {
    grid-area: stack;
    z-index: 4;
    pointer-events: none;
  }
  /* Redondeamos solo las esquinas EXTERIORES del marco para que sigan el
     border-radius del contenedor (.tow-stage, 10px). */
  .tow-side.a .tow-frame {
    border-radius: 10px 0 0 10px;
  }
  .tow-side.b .tow-frame {
    border-radius: 0 10px 10px 0;
  }
  .tow-side[data-selected='true'] .tow-frame {
    box-shadow:
      inset 0 0 0 3px var(--color-theme-gold),
      inset 0 0 44px color-mix(in srgb, var(--color-theme-gold) 22%, transparent);
  }

  .tow-caption {
    grid-area: stack;
    z-index: 3;
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05rem;
    padding: 0 0.7rem 2.4rem;
  }

  /* Indicador "Tu voto" (solo lectura: lo marca PredictionUserVotes).
     Oculto por style inline; se revela con !important cuando hay voto. */
  .tow-yourvote {
    align-self: center;
    align-items: center;
    gap: 0.28rem;
    margin-bottom: 0.5rem;
    padding: 0.24rem 0.65rem;
    border-radius: 999px;
    background: var(--color-theme-gold);
    color: var(--color-theme-midnight);
    font-size: 0.5rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    box-shadow: 0 4px 16px color-mix(in srgb, var(--color-theme-gold) 40%, transparent);
  }
  .tow-yourvote-check {
    width: 0.7rem;
    height: 0.7rem;
  }
  .tow-side[data-selected='true'] .tow-yourvote {
    display: inline-flex !important;
  }

  .tow-percent {
    font-size: clamp(1.85rem, 1rem + 3vw, 3rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--color-theme-cream);
    text-shadow:
      0 1px 3px rgba(0, 0, 0, 0.95),
      0 2px 16px rgba(0, 0, 0, 0.85);
  }
  .tow-side[data-leader='true'] .tow-percent,
  .tow-side[data-winner='true'] .tow-percent,
  .tow-side[data-selected='true'] .tow-percent {
    color: var(--color-theme-gold);
    text-shadow:
      0 0 20px color-mix(in srgb, var(--color-theme-gold) 42%, transparent),
      0 0 34px color-mix(in srgb, var(--vote-color) 26%, transparent);
  }
  .tow-side[data-winner='true'] .tow-name {
    color: color-mix(in srgb, var(--color-theme-gold) 62%, var(--color-theme-cream));
  }
  .tow-side[data-selected='true'] .tow-pic-img {
    filter: saturate(1.12) brightness(1.04);
  }
  .tow-side[data-muted='true'] .tow-pic-img {
    filter: saturate(0.6) brightness(0.6);
  }
  .tow-side[data-muted='true'] .tow-caption {
    opacity: 0.6;
  }

  .tow-name {
    margin-top: 0.35rem;
    font-size: clamp(0.92rem, 0.65rem + 1.1vw, 1.45rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--color-theme-cream);
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.9),
      0 2px 12px rgba(0, 0, 0, 0.7);
  }
  .tow-country {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin-top: 0.4rem;
    font-size: 0.5rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-theme-cream) 68%, transparent);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
  }
  :global(.tow-flag) {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }
  .tow-votes {
    margin-top: 0.3rem;
    font-size: 0.52rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-theme-cream) 52%, transparent);
  }

  /* Relleno de la barra tug-of-war (A desde izq, B desde der). */
  .tow-fill {
    position: absolute;
    bottom: 0;
    z-index: 5;
    height: 14px;
    width: var(--vote-share);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      0 0 18px color-mix(in srgb, var(--vote-color) 48%, transparent);
    pointer-events: none;
  }
  .tow-side.a .tow-fill {
    left: 0;
    /* El navy de marca es muy oscuro: lo aclaramos para que el azul se lea. */
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--vote-color) 62%, white),
      color-mix(in srgb, var(--vote-color) 38%, white)
    );
  }
  .tow-side.b .tow-fill {
    z-index: 3;
    right: 0;
    background: linear-gradient(
      270deg,
      var(--vote-color),
      color-mix(in srgb, var(--vote-color) 70%, white)
    );
  }
  /* Pivote: asa vertical dorada en el punto de corte. */
  .tow-side.a .tow-fill::after {
    content: '';
    position: absolute;
    right: -3px;
    top: 50%;
    z-index: 6;
    width: 6px;
    height: 26px;
    transform: translateY(-50%);
    border-radius: 999px;
    background: linear-gradient(
      180deg,
      #fff,
      var(--color-theme-gold) 55%,
      color-mix(in srgb, var(--color-theme-gold) 65%, black)
    );
    box-shadow:
      0 0 0 2px rgba(0, 0, 0, 0.45),
      0 0 16px color-mix(in srgb, var(--color-theme-gold) 70%, transparent);
  }

  /* Móvil: texto más pequeño y alineado al borde EXTERIOR de cada foto. */
  @media (max-width: 639px) {
    .tow-side {
      aspect-ratio: 3 / 4;
    }
    .tow-percent {
      font-size: 1.7rem;
    }
    .tow-name {
      font-size: 0.8rem;
    }
    .tow-winner-badge {
      margin: 0.4rem;
      font-size: 0.42rem;
      padding: 0.22rem 0.5rem;
    }

    .tow-side.a .tow-caption {
      align-items: flex-start;
      text-align: left;
      padding-left: 0.55rem;
      padding-right: 1.7rem;
    }
    .tow-side.b .tow-caption {
      align-items: flex-end;
      text-align: right;
      padding-right: 0.55rem;
      padding-left: 1.7rem;
    }
  }
</style>
