---
import PredictionOption from '@/components/PredictionOption.astro'
import {
  getBattleResult,
  getDecisionLabel,
  getWinnerWord,
} from '@/consts/battle-results'
import type { PredictionBattle } from '@/consts/predictions'

interface Props {
  prediction: PredictionBattle
  index?: number
}

const { prediction, index = 0 } = Astro.props
// Entrada escalonada (mismo patrón que /combates).
const animationDelay = `${index * 60}ms`
const { battle, options } = prediction
const [optionA, optionB] = options

// Líder solo si hay votos y no es empate (si no, sin halo).
const hasLeader = prediction.totalVotes > 0 && optionA.percentage !== optionB.percentage
const leaderBoxerId = hasLeader ? prediction.leader.boxer.id : undefined

const result = getBattleResult(battle.id)
const winner =
  result && (optionA.boxer.id === result.winnerId
    ? optionA.boxer
    : optionB.boxer.id === result.winnerId
      ? optionB.boxer
      : null)
const winnerWord = winner ? getWinnerWord(winner.gender) : null
const decisionLabel = result ? getDecisionLabel(result) : null
---

<li
  id={`pronostico-${battle.id}`}
  class="tow-item scroll-mt-28 not-motion-reduce:animate-fade-in-up"
  style={`animation-delay:${animationDelay}`}
>
  <article data-battle-id={battle.id} data-prediction-fight>
    <h2 class="sr-only">
      Combate {battle.number}: {optionA.boxer.name} ({optionA.countryName}) contra {
        optionB.boxer.name
      } ({optionB.countryName}){
        winner && winnerWord && decisionLabel
          ? `. ${winnerWord}: ${winner.name}. ${decisionLabel}.`
          : ''
      }
    </h2>

    <div class="tow-stage">
      <span class="tow-tag font-cinzel">Combate {String(battle.number).padStart(2, '0')}</span>

      <PredictionOption
        battleId={battle.id}
        option={optionA}
        leaderBoxerId={leaderBoxerId}
        winnerBoxerId={result?.winnerId}
      />
      <PredictionOption
        battleId={battle.id}
        option={optionB}
        leaderBoxerId={leaderBoxerId}
        winnerBoxerId={result?.winnerId}
      />

      <span aria-hidden="true" class="tow-seam"></span>

      <div class="tow-vs" aria-hidden="true">
        <span class="tow-vs-medal font-cinzel"><b>VS</b></span>
      </div>

      <span aria-hidden="true" class="tow-track"></span>
    </div>

    {
      winner && winnerWord && decisionLabel && (
        <p class="tow-result font-cinzel" aria-hidden="true">
          <span class="tow-result-label">{winnerWord}</span>
          <span class="tow-result-name">{winner.name}</span>
          <span class="tow-result-decision">{decisionLabel}</span>
        </p>
      )
    }
  </article>
</li>

<style>
  .tow-stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    border-radius: 10px;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-theme-gold) 20%, transparent),
      0 22px 60px rgba(0, 0, 0, 0.55);
  }

  /* Etiqueta del número de combate, anclada a la esquina superior izquierda. */
  .tow-tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 7;
    padding: 0.28rem 0.62rem;
    font-size: 0.5rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-theme-gold) 90%, white);
    background: color-mix(in srgb, var(--color-theme-midnight) 52%, transparent);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    border: 1px solid color-mix(in srgb, var(--color-theme-gold) 32%, transparent);
    border-radius: 0.3rem;
  }

  /* Línea divisora central (queda por DEBAJO del VS, z-index 6 < 7). */
  .tow-seam {
    position: absolute;
    top: 0;
    bottom: 14px;
    left: 50%;
    z-index: 6;
    width: 1px;
    transform: translateX(-50%);
    background: linear-gradient(
      180deg,
      transparent,
      color-mix(in srgb, var(--color-theme-gold) 38%, transparent) 30%,
      color-mix(in srgb, var(--color-theme-gold) 38%, transparent) 70%,
      transparent
    );
    pointer-events: none;
  }

  /* Carril de fondo de la barra tug-of-war. */
  .tow-track {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    height: 14px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.5));
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.5);
    pointer-events: none;
  }

  /* Medalla VS centrada entre los combatientes (en la costura, a media
     altura de las fotos, por encima de la barra). */
  .tow-vs {
    position: absolute;
    left: 50%;
    top: calc((100% - 14px) / 2);
    z-index: 7;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .tow-vs-medal {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    transform: rotate(45deg);
    border: 1px solid var(--color-theme-gold);
    /* Base sólida opaca + tinte dorado encima: oculta la línea que pasa detrás. */
    background:
      radial-gradient(
        circle,
        color-mix(in srgb, var(--color-theme-gold) 26%, transparent),
        transparent 70%
      ),
      #0a1024;
    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.55),
      0 0 24px color-mix(in srgb, var(--color-theme-gold) 22%, transparent);
  }
  .tow-vs-medal b {
    transform: rotate(-45deg);
    font-weight: 900;
    font-size: 1rem;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-theme-gold) 92%, white);
  }
  .tow-item:hover .tow-vs-medal {
    background:
      radial-gradient(
        circle,
        color-mix(in srgb, var(--color-theme-gold) 40%, transparent),
        transparent 70%
      ),
      #0a1024;
  }

  @media (max-width: 480px) {
    .tow-vs-medal {
      width: 44px;
      height: 44px;
    }
    .tow-vs-medal b {
      font-size: 0.8rem;
    }
  }

  /* Resultado oficial bajo el tug-of-war (complementa el badge del ganador). */
  .tow-result {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.3rem 0.55rem;
    margin: 0.7rem 0 0;
    padding: 0.55rem 0.75rem;
    border-radius: 0.45rem;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-theme-gold) 12%, transparent),
        color-mix(in srgb, #05080f 88%, transparent)
      ),
      #070b18;
    border: 1px solid color-mix(in srgb, var(--color-theme-gold) 26%, transparent);
    text-align: center;
    line-height: 1.2;
  }

  .tow-result-label {
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-theme-gold) 85%, transparent);
  }

  .tow-result-name {
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-theme-cream);
  }

  .tow-result-decision {
    width: 100%;
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-theme-cream) 52%, transparent);
  }
</style>
